        <script><![CDATA[
(function executeRule(current, previous) {
    if (
        current.getValue('state') !== '-5' ||
        !current.substate.changesTo('pending_requester')
    ) {
        return;
    }

    var recipient = current.getValue('u_email_solicitante');

    if (!recipient) {
        gs.error('EV: destinatário ausente no Case ' +
            current.getValue('number'));
        return;
    }

    var message = current.comments.getJournalEntry(1);

    if (!message) {
        gs.error('EV: mensagem ausente no Case ' +
            current.getValue('number'));
        return;
    }

    gs.eventQueue(
        'x_fub_fundbrad_ev.atendimento.informacao',
        current,
        recipient,
        message
    );
})(current, previous);
]]></script>
