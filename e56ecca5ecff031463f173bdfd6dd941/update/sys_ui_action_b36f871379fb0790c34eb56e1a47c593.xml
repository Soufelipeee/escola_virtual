        <client_script_v2><![CDATA[function onClick(g_form) {
    var url = '/x_fub_fundbrad_ev_ev_resolver_template_modal.do' +
        '?sysparm_record_id=' + encodeURIComponent(g_form.getUniqueValue());

    g_modal.showFrame({
        title: 'Resolver Atendimento',
        url: url,
        size: 'lg',
        height: '500px',
        showClose: true,
        closeOnEscape: false,
        callback: function (confirmed, data) {
            if (!confirmed || !data || data.success !== true) return;

            g_form.addInfoMessage('Atendimento resolvido com sucesso.');
            g_form.reload();
        }
    });
}]]></client_script_v2>
