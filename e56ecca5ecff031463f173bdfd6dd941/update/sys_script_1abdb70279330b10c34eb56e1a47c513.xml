        <script><![CDATA[
(function executeRule(current, previous) {
    var STATE_RESOLVIDO = '6';
    var STATE_EM_ATENDIMENTO = '2';

    if (current.state.changesTo(STATE_RESOLVIDO)) {
        current.setValue('resolved_by', gs.getUserID());
        current.setValue('resolved_at', new GlideDateTime());

        if (current.getValue('notes_to_comments') == '1') {
            var closeNotes = current.getValue('close_notes');

            if (closeNotes) {
                current.comments = closeNotes;
            }
        }

        return;
    }

    if (
        current.state.changesTo(STATE_EM_ATENDIMENTO) &&
        previous.getValue('state') == STATE_RESOLVIDO
    ) {
        current.setValue('resolved_by', '');
        current.setValue('resolved_at', '');
    }
})(current, previous);
]]></script>
