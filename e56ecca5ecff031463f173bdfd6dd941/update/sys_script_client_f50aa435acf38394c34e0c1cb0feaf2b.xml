        <field>u_email_solicitante</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>[FB] Verify email</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
	if (isLoading || newValue === '') {
		return;
	}

	var ga = new GlideAjax('x_fub_fundbrad_ev.EVUtils');
	ga.addParam('sysparm_name', 'ajaxValidateEmail');
	ga.addParam('sysparm_email', newValue);

	ga.getXMLAnswer(function (response) {
		if (response !== 'true') {
			g_form.clearValue('u_email_solicitante');
			getMessage('email_invalido_msg', function (msg) {
				g_form.showFieldMsg('u_email_solicitante', msg, 'error', true);
			});
		}
	});
}]]></script>
